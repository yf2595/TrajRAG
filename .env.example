# Copy to .env and fill in your credentials (never commit .env)

# OpenAI — embeddings (text-embedding-3-large) and LLM (gpt-5.1)
OPENAI_API_KEY=your_openai_key_here

# Optional alias used in some notebooks
OPENAI_API_KEY_2=your_openai_key_here

# Flightradar24 — data collection (fligh_radar_api.ipynb)
FLIGHT_RADAR_API_KEY=your_flightradar_key_here
FLIGHT_RADAR_API_KEY_2=your_flightradar_key_here

# Meteomatics — weather enrichment (if used during collection)
METEOMATICS_USERNAME=your_username
METEOMATICS_PASSWORD=your_password
